# Generate an app API key in Dify > Access Point > Backend Service API.
# This file is server-only. Never paste the key into the widget builder.
DIFY_API_URL=http://localhost/v1
DIFY_API_KEY=
# Alternatively use an already-public Dify Web App code (from /chat/CODE).
# In this mode set DIFY_API_URL=http://localhost/api, not /v1.
DIFY_WEBAPP_CODE=
PORT=3100
# Use your public HTTPS widget origin in production.
PUBLIC_ORIGIN=http://localhost:3100
# Optional Chatflow input values, configured on the server.
DIFY_INPUTS_JSON={}

# Required to sign in to Widget Studio. Choose a long unique password.
STUDIO_PASSWORD=
# Persistent chatbot connections and branding (Docker uses its named volume).
BOTS_FILE=/app/data/bots.json
